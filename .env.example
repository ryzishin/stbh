# ===== STEM Tesla BioHub — Environment =====
# Copy this file to `.env` and fill in real values.

# App
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# ===== MongoDB (REQUIRED for production) =====
# Atlas connection string (free tier is fine).
# Get it from: https://cloud.mongodb.com → your cluster → Connect → Drivers → "Node.js"
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# IMPORTANT: percent-encode special chars in the password
#   e.g. "p@ssw0rd" → "p%40ssw0rd"
#
# When unset, the app falls back to mongodb-memory-server (dev convenience only —
# data is lost on restart). Always set this in production.
MONGODB_URI=
MONGODB_DB_NAME=stbh

# ===== First-admin bootstrap (optional) =====
# When the server boots and finds zero admins in the DB, it auto-creates one
# using these credentials (if ADMIN_UID + ADMIN_PASSWORD are both set).
# Useful for fresh deploys where you can't run scripts (e.g. Render free tier).
ADMIN_UID=
ADMIN_PASSWORD=
ADMIN_NAME=Adviser
ADMIN_USERNAME=adviser

# Public URL (the deployed origin, used for absolute links & CORS)
PUBLIC_URL=http://localhost:3000
