<div class="page-head">
  <p class="kicker">Flashcards</p>
  <h1>Spaced review</h1>
  <p class="muted">Cards you missed come back sooner. Cards you know come back later. Rate each card after flipping.</p>
</div>

<div class="filter-row">
  <a href="/flashcards" class="chip <%= (!unitId && filter !== 'due' && filter !== 'new') ? 'active' : '' %>">All cards</a>
  <a href="/flashcards?filter=due" class="chip <%= filter === 'due' ? 'active' : '' %>">
    Due now<% if (typeof dueCount === 'number' && dueCount > 0) { %> · <%= dueCount %><% } %>
  </a>
  <a href="/flashcards?filter=new" class="chip <%= filter === 'new' ? 'active' : '' %>">New</a>
  <span style="flex:1"></span>
  <% units.forEach(u => { %>
    <a href="/flashcards?unit=<%= u.id %><%= filter ? '&filter=' + filter : '' %>" class="chip <%= unitId === u.id ? 'active' : '' %>"><%= u.title %></a>
  <% }) %>
</div>

<% if (cards.length === 0) { %>
  <div class="empty-state">
    <p><% if (filter === 'due') { %>No cards due right now.<% } else if (filter === 'new') { %>All cards have been seen.<% } else { %>No flashcards in this filter yet.<% } %></p>
    <p class="muted small"><% if (filter === 'due') { %>Come back tomorrow — your scheduled reviews will refresh.<% } else { %>Ask your teacher to add some.<% } %></p>
  </div>
<% } else { %>
  <div class="flashcard-stage">
    <div class="flashcard" id="flashcard">
      <div class="flashcard-face flashcard-front">
        <span class="kicker">Term</span>
        <p class="flashcard-text" id="card-front"></p>
        <small class="muted">Click to flip</small>
      </div>
      <div class="flashcard-face flashcard-back">
        <span class="kicker">Definition</span>
        <p class="flashcard-text" id="card-back"></p>
        <small class="muted">Rate your recall</small>
      </div>
    </div>

    <!-- Pre-flip controls (Prev / Next) -->
    <div class="flashcard-controls" id="pre-flip-controls">
      <button class="btn btn-outline" id="prev-card" title="Previous card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px" aria-hidden="true"><polygon points="19 20 9 12 19 4 19 20"/><line x1="5" y1="19" x2="5" y2="5"/></svg>
        Prev
      </button>
      <button class="btn btn-primary" id="flip-card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
        Flip
      </button>
      <button class="btn btn-outline" id="next-card" title="Next card">
        Next
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>
      </button>
    </div>

    <!-- Post-flip rating controls (SM-2) -->
    <div class="flashcard-controls hidden" id="rating-controls">
      <button class="btn btn-danger" data-rating="again" title="Didn't know it. See it again soon.">
        <strong>Again</strong>
      </button>
      <button class="btn btn-warn" data-rating="hard" title="Got it, but it was a struggle.">
        <strong>Hard</strong>
      </button>
      <button class="btn btn-primary" data-rating="good" title="Got it cleanly. Normal scheduling.">
        <strong>Good</strong>
      </button>
      <button class="btn btn-success" data-rating="easy" title="Easy. Push it further out.">
        <strong>Easy</strong>
      </button>
    </div>

    <p class="muted center" id="card-counter">Card 1 of <%= cards.length %></p>
    <p class="muted center tiny hidden" id="card-schedule"></p>
  </div>

  <script>
    window.__FLASHCARDS__ = <%- JSON.stringify(cards) %>;
  </script>
  <script src="/js/flashcards.js"></script>
<% } %>
